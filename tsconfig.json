{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    // Sallii ".ts"-päätteen importissa. Tarvitaan jotta yksikkötestatut
    // src/lib/shifts-moduulit voidaan ajaa "node --test"illä ilman
    // käännösvaihetta: Noden ESM-resolveri vaatii päätteen, Next ja tsc
    // eivät välitä. Vain sallii, ei pakota.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
